{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Starfall Miner C#", "type": "coreclr", "request": "launch",
      "preLaunchTask": "Build C#",
      "program": "/Applications/Godot_mono.app/Contents/MacOS/Godot",
      "args": ["--path", "${workspaceFolder}"], "cwd": "${workspaceFolder}", "stopAtEntry": false
    },
    {
      "name": "Attach to Godot C#", "type": "coreclr", "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Starfall Miner C# (Windows)", "type": "coreclr", "request": "launch",
      "preLaunchTask": "Build C# (Windows)",
      "program": "${env:GODOT4}",
      "args": ["--path", "${workspaceFolder}"], "cwd": "${workspaceFolder}", "stopAtEntry": false
    },
    {
      "name": "Planet preview (Windows)", "type": "coreclr", "request": "launch",
      "preLaunchTask": "Build C# (Windows)",
      "program": "${env:GODOT4}",
      "args": ["--path", "${workspaceFolder}", "--", "--planet-preview"],
      "cwd": "${workspaceFolder}", "stopAtEntry": false
    }
  ]
}
