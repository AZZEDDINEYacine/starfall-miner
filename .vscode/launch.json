{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Starfall Miner C#", "type": "coreclr", "request": "launch",
      "preLaunchTask": "Build C#",
      "program": "/Applications/Godot_mono.app/Contents/MacOS/Godot",
      "args": ["--path", "${workspaceFolder}"], "cwd": "${workspaceFolder}", "stopAtEntry": false
    },
    {
      "name": "Attach to Godot C#", "type": "coreclr", "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
